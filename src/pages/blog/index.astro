---
// Blog index: every published post, newest first. Posts are notes in the vault's Blog/ folder.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import posts from '../../data/posts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<StarlightPage frontmatter={{ title: 'Blog.', description: 'Updates from Voidbox Industries.', tableOfContents: false }}>
  <div class="posts not-content">
    {posts.map((p) => (
      <article>
        <p class="meta"><time datetime={p.date}>{fmt(p.date)}</time>{p.source_name && <span>first on {p.source_name}</span>}</p>
        <h2><a href={`${base}${p.path}`}>{p.title}</a></h2>
        {p.description && <p class="desc">{p.description}</p>}
      </article>
    ))}
  </div>
  <p class="feed not-content"><a href={`${base}/rss.xml`}>RSS feed ↗</a></p>
</StarlightPage>

<style>
  .posts { display: flex; flex-direction: column; gap: 2.25rem; margin-top: 2rem; max-width: 60ch; }
  .posts > * { margin: 0; }
  .meta { display: flex; gap: 1rem; margin: 0 0 0.35rem; font-family: var(--sl-font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--sl-color-gray-3); }
  .meta span { text-transform: none; letter-spacing: 0; color: var(--sl-color-gray-4); }
  h2 { font-family: var(--luna-display); font-weight: 700; font-size: 2rem; line-height: 1.05; margin: 0 0 0.5rem; text-wrap: balance; }
  h2 a { color: var(--sl-color-white); text-decoration: none; }
  h2 a:hover { color: var(--sl-color-accent); }
  .desc { margin: 0; color: var(--sl-color-gray-2); }
  .feed { margin-top: 2.5rem; font-family: var(--sl-font-mono); font-size: 0.8rem; }
  .feed a { color: var(--sl-color-gray-3); }
  .feed a:hover { color: var(--sl-color-accent); }
</style>
