---
// Landing page: the vault's Pages/Home note, published as ordered chunks under src/data/home/.
// Prose chunks render as Markdown; a cards chunk is a list of product paths rendered as the card grid.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import products from '../data/products.json';
import meta from '../data/home/meta.json';
import LinkButton from 'starlight-theme-luna/components/LinkButton.astro';
import { classifyLink } from 'starlight-theme-luna/links';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prose = import.meta.glob('../data/home/*.md', { eager: true });
const grids = import.meta.glob('../data/home/*.cards.json', { eager: true });
const blocks = [
  ...Object.entries(prose).map(([k, m]) => ({ k, Content: m.Content })),
  ...Object.entries(grids).map(([k, m]) => ({ k, cards: m.default.cards })),
].sort((a, b) => a.k.localeCompare(b.k));
const byPath = new Map(products.map((p) => [p.path, p]));
const LABEL = { production: 'Production', out_of_stock: 'Out of stock', validation: 'Validation', preorder: 'Pre-order' };
const shopLink = (p) => (p.links ?? []).map((l) => ({ ...l, ...classifyLink(l.url, l.label) })).find((l) => l.kind === 'shop');
---
<StarlightPage frontmatter={{ title: meta.title, description: meta.description, tableOfContents: false, pagefind: false }}>
  <div class="landing not-content">
  {blocks.map((b) => b.cards ? (
    <section class="cards">
      {b.cards.map((path) => byPath.get(path)).filter(Boolean).map((p) => (
        <article class="card">
          <a class="hero" href={`${base}${p.path}`} aria-label={p.name}>
            {p.hero ? <img src={`${base}${p.hero}`} alt="" loading="lazy" /> : <span class="hero-empty">{p.name}</span>}
            {LABEL[p.status] ? <span class="tag">{LABEL[p.status]}</span> : shopLink(p) && <span class="tag">{shopLink(p).label} ↗</span>}
          </a>
          <h2><a href={`${base}${p.path}`}>{p.name}</a></h2>
          <p>{p.description}</p>
          <p class="links">
            {shopLink(p) && <LinkButton href={shopLink(p).url} kind="shop" label={shopLink(p).label} />}
            <a class="docs" href={`${base}${p.path}`}>Documentation ↗</a>
          </p>
        </article>
      ))}
    </section>
  ) : (
    <section class="copy"><b.Content /></section>
  ))}
  </div>
</StarlightPage>

<style>
  .landing { display: flex; flex-direction: column; gap: 2.5rem; margin-top: 2rem; }
  .landing > * { margin: 0; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.75rem; }
  .card .hero { position: relative; display: block; aspect-ratio: 1 / 1; border-radius: 22px; overflow: hidden; background: var(--luna-tint); }
  .card .hero img { width: 100%; height: 100%; object-fit: contain; padding: 8%; box-sizing: border-box; display: block; filter: var(--luna-render-shadow); }
  .card .hero-empty { display: grid; place-items: center; height: 100%; font-family: var(--luna-display); font-size: 2rem; color: var(--sl-color-gray-3); }
  .card .tag { position: absolute; left: 1rem; bottom: 0.9rem; font-family: var(--sl-font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--sl-color-white); background: color-mix(in srgb, var(--sl-color-black) 70%, transparent); padding: 0.25rem 0.5rem; border-radius: 6px; }
  .card h2 { font-family: var(--luna-display); font-weight: 700; font-size: 2.25rem; line-height: 1; margin: 1rem 0 0.4rem; }
  .card h2 a { color: var(--sl-color-white); text-decoration: none; }
  .card p { color: var(--sl-color-gray-2); margin: 0; max-width: 40ch; }
  .card .links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.75rem; font-family: var(--sl-font-mono); font-size: 0.85rem; text-transform: uppercase; }
  .card .links a.docs { color: var(--sl-color-white); text-decoration: none; border-bottom: 1px solid var(--sl-color-white); }
  .card .links a.docs:hover { color: var(--sl-color-accent); border-color: var(--sl-color-accent); }
  @media (max-width: 40rem) { .cards { grid-template-columns: 1fr; } }
  /* Prose from the Home note: each H2 starts a block like the old hand-built sections */
  .copy { max-width: 60ch; }
  .copy :global(h2) { font-family: var(--luna-display); font-weight: 700; font-size: 2rem; line-height: 1.05; margin: 2.5rem 0 0.6rem; }
  .copy :global(h2:first-child) { margin-top: 0; }
  .copy :global(h2 a) { color: var(--sl-color-white); text-decoration: none; }
  .copy :global(h2 a:hover) { color: var(--sl-color-accent); }
  .copy :global(p), .copy :global(li) { color: var(--sl-color-gray-2); }
  .copy :global(p + p), .copy :global(blockquote + p), .copy :global(ul + p) { margin-top: 0.75rem; }
  .copy :global(ul) { padding-left: 1.2rem; }
  .copy :global(p a), .copy :global(li a) { color: var(--sl-color-accent); }
  .copy :global(blockquote) { margin: 0 0 0.75rem; padding: 0; border: 0; font-family: var(--sl-font-mono); font-size: 0.95rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  .copy :global(strong) { color: var(--sl-color-white); font-weight: 600; }
  .copy :global(p > em:only-child) { font-family: var(--sl-font-mono); font-style: normal; font-size: 0.75rem; color: var(--sl-color-gray-4); }
  .copy :global(.starlight-aside) { margin: 1rem 0; }
</style>
