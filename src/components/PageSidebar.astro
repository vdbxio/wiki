---
// Starlight's PageSidebar with the desktop TOC shown from 64rem up (default is 72rem).
import MobileToc from './MobileToc.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
---
{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="toc-mobile"><MobileToc /></div>
      <div class="right-sidebar-panel toc-desktop"><div class="sl-container"><TableOfContents /></div></div>
    </>
  )
}

<style>
  .toc-desktop { display: none; }
  @media (min-width: 64rem) {
    .toc-mobile { display: none; }
    .toc-desktop { display: block; }
    :root { --sl-mobile-toc-height: 0rem; }
  }
  .right-sidebar-panel { padding: 1rem var(--sl-sidebar-pad-x); }
  .sl-container { width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x)); }
  .right-sidebar-panel :global(h2) { font-family: var(--sl-font-mono); font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sl-color-gray-3); line-height: 1.4; margin-bottom: 0.6rem; }
  .right-sidebar-panel :global(:where(a)) { display: block; font-size: var(--sl-text-xs); text-decoration: none; color: var(--sl-color-gray-3); overflow-wrap: anywhere; }
  .right-sidebar-panel :global(:where(a):hover) { color: var(--sl-color-white); }
</style>
