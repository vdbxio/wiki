---
// Compact table of contents for narrow screens: one horizontally scrolling row of headings.
// H2s are primary; H3s ride inline after their parent, smaller and dimmer with a leading mark.
// Wrapped in Starlight's <starlight-toc> element so its scroll-spy marks the active heading.
const { toc } = Astro.locals.starlightRoute;
const flat = (items, depth = 0) => items.flatMap((i) => [{ ...i, depth }, ...flat(i.children ?? [], depth + 1)]);
const items = toc ? flat(toc.items) : [];
---
{toc && (
  <starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel} class="mtoc">
    <nav aria-label="On this page" class="mtoc-nav">
      <button type="button" class="chev prev" aria-label="Scroll headings left">‹</button>
      <div class="mtoc-row">
        {items.map((i) => <a href={`#${i.slug}`} draggable="false" class:list={{ sub: i.depth > 0 }}>{i.text}</a>)}
      </div>
      <button type="button" class="chev next" aria-label="Scroll headings right">›</button>
    </nav>
  </starlight-toc>
)}

<script>
  // Keep the active heading in view as you scroll the page; chevrons and drag for mouse users.
  document.querySelectorAll<HTMLElement>('.mtoc').forEach((toc) => {
    const row = toc.querySelector<HTMLElement>('.mtoc-row'); if (!row) return;
    const nav = toc.querySelector<HTMLElement>('.mtoc-nav')!;
    const update = () => {
      nav.classList.toggle('overflowing', row.scrollWidth > row.clientWidth + 2);
      nav.classList.toggle('at-start', row.scrollLeft <= 1);
      nav.classList.toggle('at-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 1);
    };
    toc.querySelector('.chev.prev')?.addEventListener('click', () => row.scrollBy({ left: -row.clientWidth * 0.6, behavior: 'smooth' }));
    toc.querySelector('.chev.next')?.addEventListener('click', () => row.scrollBy({ left: row.clientWidth * 0.6, behavior: 'smooth' }));
    row.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(row);
    new MutationObserver(() => {
      if (row.classList.contains('dragging')) return;
      row.querySelector<HTMLElement>('a[aria-current="true"]')?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
    }).observe(row, { subtree: true, attributes: true, attributeFilter: ['aria-current'] });
    let startX = 0, startLeft = 0, dragging = false, moved = false;
    row.addEventListener('dragstart', (e) => e.preventDefault());
    row.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || e.button !== 0) return; dragging = true; moved = false; startX = e.clientX; startLeft = row.scrollLeft; });
    row.addEventListener('pointermove', (e) => { if (!dragging) return; const dx = e.clientX - startX; if (!moved && Math.abs(dx) > 4) { moved = true; row.setPointerCapture(e.pointerId); row.classList.add('dragging'); } if (moved) row.scrollLeft = startLeft - dx; });
    const end = () => { dragging = false; row.classList.remove('dragging'); };
    row.addEventListener('pointerup', end); row.addEventListener('pointercancel', end);
    row.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } moved = false; }, true);
    update();
  });
</script>

<style>
  .mtoc-nav { position: fixed; z-index: var(--sl-z-index-toc); top: calc(var(--sl-nav-height) - 1px); inset-inline: 0; height: var(--sl-mobile-toc-height); background-color: var(--sl-color-bg-nav); border-bottom: 1px solid var(--sl-color-hairline-shade); }
  @media (min-width: 50rem) { .mtoc-nav { inset-inline-start: var(--sl-content-inline-start, 0); } }
  .mtoc-row { display: flex; align-items: center; gap: 1rem; height: 100%; padding: 0 1.25rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scroll-padding-inline: 1.25rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; white-space: nowrap; cursor: grab; user-select: none; -webkit-user-drag: none; mask-image: linear-gradient(to right, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent); }
  .mtoc-row::-webkit-scrollbar { display: none; }
  .mtoc-row.dragging { scroll-snap-type: none; cursor: grabbing; }
  .mtoc-row a { flex: none; scroll-snap-align: start; font-family: var(--sl-font-mono); font-size: 0.82rem; color: var(--sl-color-gray-2); text-decoration: none; -webkit-user-drag: none; }
  .mtoc-row a.sub { font-size: 0.74rem; color: var(--sl-color-gray-4); margin-inline-start: -0.45rem; }
  .mtoc-row a.sub::before { content: '· '; color: var(--sl-color-gray-5); }
  .mtoc-row a[aria-current='true'] { color: var(--sl-color-accent); font-weight: 700; }
  .chev { position: absolute; top: 50%; transform: translateY(-50%); z-index: 1; width: 1.5rem; height: 1.5rem; border: 0; border-radius: 999px; background: var(--sl-color-black); color: var(--sl-color-white); font-family: var(--sl-font-mono); font-size: 1rem; line-height: 1; cursor: pointer; display: none; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--sl-color-hairline-shade); }
  .chev.prev { left: 0.4rem; } .chev.next { right: 0.4rem; }
  .mtoc-nav.overflowing:not(.at-start) .chev.prev, .mtoc-nav.overflowing:not(.at-end) .chev.next { display: inline-flex; }
  @media (pointer: coarse) { .chev { display: none !important; } }
</style>
