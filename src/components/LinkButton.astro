---
// One inline button: icon + label, colored by kind. Used for external links and public files.
import type { Kind } from '../lib/links';
interface Props { href: string; kind: Kind; label: string; ext?: string; download?: boolean; title?: string }
const { href, kind, label, ext = '', download = false, title } = Astro.props;
const external = /^https?:/.test(href);
---
<a class={`lb lb-${kind}`} href={href} title={title ?? label} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} download={download ? '' : undefined}>
  {kind === 'shop' && <b class="dollar" aria-hidden="true">$</b>}
  {kind === 'repo' && <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>}
  {kind === 'source' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h3M16 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3M9 12h6M9 8h2M13 16h2"/></svg>}
  {kind === 'cad' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5zM3 7l9 5 9-5M12 12v10"/></svg>}
  {kind === 'doc' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM14 2v6h6M8 13h8M8 17h8"/></svg>}
  {kind === 'archive' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7zM3 7l2-4h14l2 4M10 11h4"/></svg>}
  {kind === 'firmware' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6zM9 9h6v6H9zM3 9h3M3 15h3M18 9h3M18 15h3M9 3v3M15 3v3M9 18v3M15 18v3"/></svg>}
  {kind === 'video' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM10 9l5 3-5 3z"/></svg>}
  {kind === 'chat' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>}
  {kind === 'image' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 9h.01"/></svg>}
  {kind === 'link' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>}
  <span>{label}</span>{ext && <em>.{ext}</em>}{external && <i class="ext" aria-hidden="true">↗</i>}
</a>

<style>
  .sl-markdown-content .lb, .lb { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.7rem 0.35rem 0.55rem; border-radius: 0.55rem; font-family: var(--sl-font-mono); font-size: 0.82rem; line-height: 1.2; text-decoration: none; color: #111; background: var(--lb, var(--sl-color-gray-5)); border: 1px solid transparent; white-space: nowrap; max-width: 100%; }
  .lb:hover { filter: brightness(1.08); }
  .lb span { overflow: hidden; text-overflow: ellipsis; }
  .lb em { font-style: normal; opacity: 0.6; }
  .lb .dollar { font-family: var(--sl-font-mono); font-weight: 700; font-size: 1.05rem; line-height: 1; width: 1rem; text-align: center; flex: none; }
  .lb .ext { font-style: normal; margin-inline-start: 0.1rem; }
  .lb svg { width: 1rem; height: 1rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .lb svg.fill { fill: currentColor; stroke: none; }
  .lb-shop { --lb: var(--vdbx-btn-shop); }
  .lb-repo, .lb-source { --lb: var(--vdbx-btn-source); }
  .lb-cad { --lb: var(--vdbx-btn-cad); }
  .lb-doc, .lb-archive, .lb-firmware { --lb: var(--vdbx-btn-doc); }
  .lb-video, .lb-chat { --lb: var(--vdbx-btn-media); }
  .lb-link, .lb-image { --lb: var(--vdbx-btn-plain); color: var(--sl-color-white); }
</style>
