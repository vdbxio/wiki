---
// "Connect": the browser installer. Lists every published product that has a firmware manifest and
// hands off to ESP Web Tools, which opens Chrome's serial-port dialog and flashes the board.
import products from '../data/products.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const targets = products.filter((p) => p.firmware);
---
<dialog id="vdbx-connect" class="connect" aria-labelledby="connect-title">
  <form method="dialog" class="frame">
    <header>
      <h2 id="connect-title">Connect.</h2>
      <button value="close" class="close" aria-label="Close">✕</button>
    </header>
    <p class="lede">Plug the board into this computer with a USB-C data cable, pick it below, then choose its port when the browser asks. Works in Chrome and Edge on a computer.</p>
    <div class="targets">
      {targets.map((p) => (
        <div class="target">
          <div class="pic">{p.hero && <img src={`${base}${p.hero}`} alt="" loading="lazy" />}</div>
          <div class="info">
            <h3>{p.name}</h3>
            <p class="ver" data-version-for={p.firmware}>&nbsp;</p>
            <esp-web-install-button manifest={p.firmware}>
              <button slot="activate" type="button" class="go">Install ↗</button>
              <span slot="unsupported" class="warn">Needs Chrome or Edge on a computer.</span>
              <span slot="not-allowed" class="warn">Serial access is blocked here.</span>
            </esp-web-install-button>
          </div>
        </div>
      ))}
    </div>
    <p class="fine">Firmware is the latest release of <a href="https://github.com/vdbxio/esphome-configs/releases" target="_blank" rel="noopener">vdbxio/esphome-configs</a>. Installing replaces what is on the board; Wi-Fi setup follows in the same dialog.</p>
  </form>
</dialog>

<script>
  const dlg = document.getElementById('vdbx-connect') as HTMLDialogElement | null;
  let loaded = false;
  async function openConnect() {
    if (!dlg) return;
    dlg.showModal();
    if (loaded) return;
    loaded = true;
    try {
      await import(/* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/esp-web-tools@10/dist/web/install-button.js');
    } catch { /* the unsupported slot still explains what to do */ }
    for (const el of dlg.querySelectorAll<HTMLElement>('[data-version-for]')) {
      fetch(el.dataset.versionFor!).then((r) => r.json()).then((m) => { el.textContent = m.version ? `Firmware ${m.version}` : ''; }).catch(() => { el.textContent = ''; });
    }
  }
  document.querySelectorAll('[data-connect-open]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); openConnect(); }));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .connect { margin: auto; inset: 0; width: min(44rem, calc(100vw - 2rem)); border: 1px solid var(--sl-color-hairline-shade); border-radius: 22px; padding: 0; background: var(--sl-color-black); color: var(--sl-color-white); }
  .connect::backdrop { background: color-mix(in srgb, var(--sl-color-black) 70%, transparent); backdrop-filter: blur(6px); }
  .frame { display: flex; flex-direction: column; gap: 1.1rem; padding: 1.75rem 1.9rem 1.5rem; }
  header { display: flex; align-items: center; justify-content: space-between; }
  h2 { font-family: var(--vdbx-display); font-weight: 700; font-size: 2.2rem; line-height: 1; margin: 0; }
  .close { width: 2.25rem; height: 2.25rem; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.5rem; background: transparent; color: var(--sl-color-white); font-family: var(--sl-font-mono); cursor: pointer; }
  .close:hover { border-color: var(--sl-color-white); }
  .lede { margin: 0; color: var(--sl-color-gray-2); max-width: 58ch; }
  .targets { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .target { display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--sl-color-hairline-shade); border-radius: 16px; overflow: hidden; }
  .pic { background: var(--vdbx-tint); aspect-ratio: 16 / 9; }
  .pic img { width: 100%; height: 100%; object-fit: contain; padding: 6%; box-sizing: border-box; display: block; }
  .info { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
  h3 { font-family: var(--vdbx-display); font-weight: 700; font-size: 1.5rem; line-height: 1; margin: 0; }
  .ver { margin: 0; font-family: var(--sl-font-mono); font-size: 0.78rem; color: var(--sl-color-gray-3); min-height: 1.2em; }
  .go { align-self: flex-start; margin-top: 0.4rem; font-family: var(--sl-font-mono); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; padding: 0.5rem 0.9rem; border: 1px solid var(--sl-color-white); border-radius: 0.5rem; background: var(--sl-color-white); color: var(--sl-color-black); cursor: pointer; }
  .go:hover { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: #fff; }
  .warn { font-family: var(--sl-font-mono); font-size: 0.8rem; color: var(--vdbx-caution-edge); }
  .fine { margin: 0; font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-4); }
  .fine a { color: inherit; }
</style>
