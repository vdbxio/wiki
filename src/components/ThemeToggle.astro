---
// Icon-only light/dark toggle. Uses the same localStorage key as Starlight's ThemeProvider so the
// inline no-FOUC script keeps working. Auto (system) is what you get until you click.
---
<vdbx-theme-toggle>
  <button type="button" aria-label="Toggle light or dark theme" title="Theme">
    <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </button>
</vdbx-theme-toggle>

<script>
  class VdbxThemeToggle extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector('button');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });
    }
  }
  customElements.define('vdbx-theme-toggle', VdbxThemeToggle);
</script>

<style>
  button { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.5rem; background: transparent; color: var(--sl-color-white); cursor: pointer; }
  button:hover { border-color: var(--sl-color-white); }
  svg { grid-area: 1 / 1; }
  :global(:root[data-theme='dark']) .sun, :global(:root:not([data-theme='dark'])) .moon { display: none; }
</style>
