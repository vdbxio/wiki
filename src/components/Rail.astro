---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import Connect from './Connect.astro';
import cube from '../cube.svg?raw';

const { sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const GITHUB = 'https://github.com/vdbxio';
const DISCORD = 'https://discord.gg/mDYYXy3Erm';
const hasCurrent = (entries) => entries.some((e) => (e.type === 'link' ? e.isCurrent : hasCurrent(e.entries)));
// Mobile: sections as one scrolling row, the selected section's pages as a second row.
const flat = (entries) => entries.flatMap((e) => (e.type === 'link' ? [{ ...e, child: false }] : e.entries.map((l, i) => ({ ...l, child: i > 0 }))));
const groups = sidebar.filter((g) => g.type === 'group').map((g) => ({ label: g.label, pages: flat(g.entries), current: hasCurrent(g.entries) }));
const activeIdx = Math.max(0, groups.findIndex((g) => g.current));
---
<button type="button" class="connect-float" data-connect-open title="Flash a board from your browser">Connect</button>
<div class="rail">
  <a class="cube" href={`${base}/`} aria-label="Voidbox Industries home" set:html={cube} />

  <div class="nav">
    {sidebar.map((g) =>
      g.type === 'group' ? (
        <details open={hasCurrent(g.entries)}>
          <summary class="top">{g.label}</summary>
          <ul>
            {g.entries.map((e) =>
              e.type === 'link' ? (
                <li><a href={e.href} aria-current={e.isCurrent ? 'page' : undefined}>{e.label}</a></li>
              ) : (
                <li>
                  <ul class="nest">
                    {e.entries.map((l, i) => (
                      <li class={i ? 'child' : ''}><a href={l.href} aria-current={l.isCurrent ? 'page' : undefined}>{l.label}</a></li>
                    ))}
                  </ul>
                </li>
              )
            )}
          </ul>
        </details>
      ) : (
        <a class="top" href={g.href} aria-current={g.isCurrent ? 'page' : undefined}>{g.label}</a>
      )
    )}
  </div>

  <div class="mnav" aria-label="Sections">
    <div class="mscroll">
      <button type="button" class="chev prev" aria-label="Scroll sections left">‹</button>
      <div class="mrow sections" role="tablist">
        {groups.map((g, i) => <button type="button" role="tab" class="mtab" data-sec={i} aria-selected={i === activeIdx ? 'true' : 'false'}>{g.label}</button>)}
      </div>
      <button type="button" class="chev next" aria-label="Scroll sections right">›</button>
    </div>
    {groups.map((g, i) => (
      <div class="mscroll" data-sec={i} hidden={i !== activeIdx}>
        <button type="button" class="chev prev" aria-label="Scroll pages left">‹</button>
        <div class="mrow pages" data-sec={i}>
          {g.pages.map((l) => <a href={l.href} draggable="false" class:list={{ child: l.child }} aria-current={l.isCurrent ? 'page' : undefined}>{l.label}</a>)}
        </div>
        <button type="button" class="chev next" aria-label="Scroll pages right">›</button>
      </div>
    ))}
  </div>

  <div class="foot">
    <p class="meta">VDBX.io<br />CC-BY-SA 4.0<br />Voidbox Industries<br />Branding rights reserved</p>
    <div class="tools print:hidden">
      <Search />
      <ThemeToggle />
      <a class="icon" href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
      </a>
      <a class="icon" href={DISCORD || undefined} target="_blank" rel="noopener" aria-label="Discord" title={DISCORD ? 'Discord' : 'Discord (invite link not set yet)'} aria-disabled={DISCORD ? undefined : 'true'}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19.6 5.3A17 17 0 0 0 15.4 4l-.5 1a16 16 0 0 0-5.8 0l-.5-1a17 17 0 0 0-4.2 1.3C1.7 9.3 1 13.2 1.4 17a17 17 0 0 0 5.2 2.6l1.1-1.8c-.6-.2-1.2-.5-1.7-.8l.4-.3a12 12 0 0 0 11.2 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.8a17 17 0 0 0 5.2-2.6c.5-4.4-.8-8.3-3-11.7zM8.7 14.7c-1 0-1.9-1-1.9-2.1s.8-2.1 1.9-2.1 1.9 1 1.9 2.1-.8 2.1-1.9 2.1zm6.6 0c-1 0-1.9-1-1.9-2.1s.8-2.1 1.9-2.1 1.9 1 1.9 2.1-.8 2.1-1.9 2.1z"/></svg>
      </a>
    </div>
  </div>
  <Connect />
</div>

<script>
  // Desktop rail: remember how far the section list was scrolled between pages, and make sure the
  // current page's link is visible on load.
  {
    const nav = document.querySelector<HTMLElement>('.rail .nav');
    if (nav) {
      const key = 'vdbx-rail-scroll';
      try { const saved = sessionStorage.getItem(key); if (saved) nav.scrollTop = Number(saved); } catch {}
      nav.querySelector<HTMLElement>('a[aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
      nav.addEventListener('scroll', () => { try { sessionStorage.setItem(key, String(nav.scrollTop)); } catch {} }, { passive: true });
    }
  }

  // Native horizontal scrolling (touch, trackpad, shift+wheel) is left alone. For mouse-only users each
  // row gets end chevrons that nudge it and click-and-drag scrolling. Section tabs swap the pages row.
  const mnav = document.querySelector('.mnav');
  if (mnav) {
    const tabs = [...mnav.querySelectorAll<HTMLButtonElement>('.mtab')];
    const pageScrollers = [...mnav.querySelectorAll<HTMLElement>('.mscroll[data-sec]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      pageScrollers.forEach((s) => { s.hidden = s.dataset.sec !== t.dataset.sec; if (!s.hidden) update(s); });
      t.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: 'smooth' });
    }));
    function update(scroller: HTMLElement) {
      const row = scroller.querySelector<HTMLElement>('.mrow'); if (!row) return;
      const over = row.scrollWidth > row.clientWidth + 2;
      scroller.classList.toggle('at-start', row.scrollLeft <= 1);
      scroller.classList.toggle('at-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 1);
      scroller.classList.toggle('overflowing', over);
    }
    mnav.querySelectorAll<HTMLElement>('.mscroll').forEach((scroller) => {
      const row = scroller.querySelector<HTMLElement>('.mrow'); if (!row) return;
      scroller.querySelector('.chev.prev')?.addEventListener('click', () => row.scrollBy({ left: -row.clientWidth * 0.6, behavior: 'smooth' }));
      scroller.querySelector('.chev.next')?.addEventListener('click', () => row.scrollBy({ left: row.clientWidth * 0.6, behavior: 'smooth' }));
      row.addEventListener('scroll', () => update(scroller), { passive: true });
      // drag to scroll with a mouse; a real drag swallows the click that would follow it
      let startX = 0, startLeft = 0, dragging = false, moved = false;
      row.addEventListener('dragstart', (e) => e.preventDefault());
      row.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || e.button !== 0) return; dragging = true; moved = false; startX = e.clientX; startLeft = row.scrollLeft; });
      row.addEventListener('pointermove', (e) => { if (!dragging) return; const dx = e.clientX - startX; if (!moved && Math.abs(dx) > 4) { moved = true; row.setPointerCapture(e.pointerId); row.classList.add('dragging'); } if (moved) row.scrollLeft = startLeft - dx; });
      const end = () => { dragging = false; row.classList.remove('dragging'); };
      row.addEventListener('pointerup', end); row.addEventListener('pointercancel', end);
      row.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } moved = false; }, true);
      update(scroller);
    });
    new ResizeObserver(() => mnav.querySelectorAll<HTMLElement>('.mscroll').forEach(update)).observe(mnav);
    mnav.querySelector<HTMLElement>('.mtab[aria-selected="true"]')?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    mnav.querySelector<HTMLElement>('.mrow.pages a[aria-current="page"]')?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
  }
</script>

<style>
  .rail { position: relative; display: flex; flex-direction: column; gap: 1.6rem; height: 100%; min-height: 0; font-family: var(--sl-font-mono); }
  /* positioned against the rail container, which is stuck to the window's top edge */
  .connect-float { position: absolute; top: 1rem; right: 1rem; z-index: 1; padding: 0.32rem 0.7rem; border: 1.5px solid var(--sl-color-accent); border-radius: 999px; background: transparent; color: var(--sl-color-accent); font-family: var(--sl-font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
    /* a faint glow from the border color, outside and inside */
    box-shadow: 0 0 10px color-mix(in srgb, var(--sl-color-accent) 35%, transparent), inset 0 0 8px color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    text-shadow: 0 0 8px color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    transition: box-shadow 0.15s, text-shadow 0.15s; }
  .connect-float:hover { box-shadow: 0 0 16px color-mix(in srgb, var(--sl-color-accent) 60%, transparent), inset 0 0 10px color-mix(in srgb, var(--sl-color-accent) 25%, transparent); text-shadow: 0 0 10px color-mix(in srgb, var(--sl-color-accent) 80%, transparent); }
  .cube { display: block; width: var(--vdbx-cube); color: var(--sl-color-white); }
  .cube :global(svg) { width: 100%; height: auto; fill: currentColor; display: block; }
  /* the nav takes the remaining height and scrolls on its own; logo and footer stay put */
  .nav { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 auto; min-height: 0; overflow-y: auto; scrollbar-width: thin; padding-bottom: 1rem; mask-image: linear-gradient(to bottom, #000 calc(100% - 1.25rem), transparent); }
  .nav a, .nav summary { text-decoration: none; color: var(--sl-color-white); line-height: 1.5; }
  .nav .top { font-size: 1.8rem; line-height: 1.15; }
  .nav a:hover, .nav summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  details > summary { list-style: none; cursor: pointer; user-select: none; }
  summary::-webkit-details-marker { display: none; }
  details[open] > summary::after { content: ''; }
  .nav ul { list-style: none; margin: 0.25rem 0 0.6rem; padding: 0 0 0 0.9rem; border-inline-start: 1px solid var(--sl-color-hairline-light); display: flex; flex-direction: column; gap: 0.15rem; }
  .nav ul ul.nest { margin: 0; padding: 0; border: 0; }
  .nav ul a { font-size: 0.86rem; color: var(--sl-color-gray-2); }
  .nav li.child a { padding-inline-start: 0.9rem; color: var(--sl-color-gray-3); }
  .nav a[aria-current='page'] { color: var(--sl-color-accent); font-weight: 700; }
  .mnav { display: none; }
  .foot { display: flex; flex-direction: column; gap: 0.7rem; flex: 0 0 auto; padding-inline-end: 1.5rem; }
  .tools { display: flex; flex-direction: row; gap: 0.5rem; }
  .icon { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border: 1px solid var(--sl-color-hairline-shade); border-radius: 0.5rem; color: var(--sl-color-white); }
  .icon:hover { border-color: var(--sl-color-white); }
  .icon[aria-disabled='true'] { opacity: 0.4; pointer-events: none; }
  .meta { margin: 0; font-size: 0.72rem; line-height: 1.7; color: var(--sl-color-gray-4); }
  @media (max-width: 49.99rem) {
    /* one header row: logo · icons centered · Connect, all on a line; the nav rows beneath */
    .rail { display: contents; }
    :global(.vdbx-rail) { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "cube foot connect" "mnav mnav mnav"; align-items: center; column-gap: 1rem; row-gap: 0.5rem; }
    .cube { grid-area: cube; width: 3rem; }
    .connect-float { grid-area: connect; position: static; justify-self: end; }
    .foot { grid-area: foot; justify-self: center; }
    .mnav { grid-area: mnav; }
    .nav { display: none; }
    .mnav { display: flex; flex-direction: column; gap: 0.2rem; margin-inline: -1.25rem; }
    .mscroll { position: relative; }
    .mscroll[hidden] { display: none; }
    .chev { position: absolute; top: 50%; transform: translateY(-50%); z-index: 1; width: 1.6rem; height: 1.6rem; border: 0; border-radius: 999px; background: var(--sl-color-black); color: var(--sl-color-white); font-family: var(--sl-font-mono); font-size: 1.1rem; line-height: 1; cursor: pointer; display: none; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--sl-color-hairline-shade); }
    .chev.prev { left: 0.4rem; } .chev.next { right: 0.4rem; }
    .mscroll.overflowing:not(.at-start) .chev.prev, .mscroll.overflowing:not(.at-end) .chev.next { display: inline-flex; }
    @media (pointer: coarse) { .chev { display: none !important; } }
    .mrow { display: flex; gap: 0.25rem 1.1rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scroll-padding-inline: 1.25rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding: 0.35rem 1.25rem; white-space: nowrap; mask-image: linear-gradient(to right, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent); }
    .mrow::-webkit-scrollbar { display: none; }
    .mrow > * { scroll-snap-align: start; flex: none; }
    .mrow { cursor: grab; user-select: none; -webkit-user-drag: none; }
    .mrow.dragging { scroll-snap-type: none; scroll-behavior: auto; }
    .mrow a, .mrow button { -webkit-user-drag: none; }
    .mrow:active { cursor: grabbing; }
    .mtab { background: none; border: 0; padding: 0; font: inherit; font-size: 1.35rem; line-height: 1.2; color: var(--sl-color-white); cursor: pointer; }
    .mtab[aria-selected='true'] { color: var(--sl-color-accent); font-weight: 700; }
    .mrow.pages a { font-size: 0.9rem; color: var(--sl-color-gray-2); text-decoration: none; }
    .mrow.pages a.child::before { content: '↳ '; color: var(--sl-color-gray-4); }
    .mrow.pages a[aria-current='page'] { color: var(--sl-color-accent); font-weight: 700; }
    .foot { flex-direction: row; align-items: center; padding: 0; gap: 0.75rem; }
    .meta { display: none; }
  }
</style>
